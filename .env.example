# Copy this file to `.env` and fill in your own keys. NEVER commit the real .env file.

# Free Groq API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Free FRED API key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Optional: Weights & Biases (free tier) for experiment tracking
WANDB_API_KEY=

# Local paths (defaults shown; usually no need to change)
CHROMA_PERSIST_DIR=./data/chroma_store
CACHE_DIR=./data/raw/llm_cache
